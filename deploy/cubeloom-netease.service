[Unit]
Description=Cubeloom NetEase import service
After=network.target cubeloom.service

[Service]
Type=simple
WorkingDirectory=/opt/cubeloom
EnvironmentFile=/opt/cubeloom/netease/netease.env
ExecStart=/usr/bin/env node node_modules/tsx/dist/cli.mjs netease-service.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
