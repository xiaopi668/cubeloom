+        set(_PY312_LIB "${PY312_ROOT}/lib/libpython3.12.so")
+    endif()
+    add_library(Python3::Python SHARED IMPORTED)
+    set_target_properties(Python3::Python PROPERTIES
+        IMPORTED_LOCATION "${_PY312_LIB}"
+        INTERFACE_INCLUDE_DIRECTORIES "${PY312_ROOT}/include/python3.12")
+    set(Python3_INCLUDE_DIRS "${PY312_ROOT}/include/python3.12")
+endif()
 
