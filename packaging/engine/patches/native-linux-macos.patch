diff --git a/application/Python/PythonRuntime.cpp b/application/Python/PythonRuntime.cpp
index e10081d0..5b403f72 100644
--- a/application/Python/PythonRuntime.cpp
+++ b/application/Python/PythonRuntime.cpp
@@ -1,8 +1,16 @@
 // windows.h must come first in this TU so the Windows SDK headers parse before
 // any `using namespace std;` (from project headers) can make std::byte collide
 // with the SDK's `byte` typedef.
+#ifdef _WIN32
 #include <windows.h>
+#elif defined(__APPLE__)
+#include <mach-o/dyld.h>
+#else
+#include <unistd.h>
+#include <limits.h>
+#endif
 #include <stdlib.h>   // _putenv_s (VECTOR_PLUGIN_DIR)
+#include <cwchar>
 #include "PythonRuntime.h"
 #include "PythonApi.h"
 #include "fopmodule.h"
@@ -42,7 +50,41 @@ static void SetPythonHome()
         Py_SetPythonHome(whome.c_str());
     }
 #else
-    Py_SetPythonHome(L".");
+    // Linux: /proc/self/exe；macOS 用 _NSGetExecutablePath
+    std::string home = "python312";
+    char exe[4096] = {0};
+#ifdef __APPLE__
+    uint32_t size = sizeof(exe);
+    if (_NSGetExecutablePath(exe, &size) == 0) {
+        std::string p(exe);
+        size_t s = p.find_last_of("/");
+        if (s != std::string::npos) home = p.substr(0, s) + "/python312";
+    }
+#else
+    ssize_t n = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+    if (n > 0) {
+        exe[n] = 0;
+        std::string p(exe);
+        size_t s = p.find_last_of("/");
+        if (s != std::string::npos) home = p.substr(0, s) + "/python312";
+    }
+#endif
+    // Android/容器里 python312 不一定在可执行文件旁，可用环境变量指定
+    if (const char* envHome = getenv("VECTOR_PYTHON_HOME")) {
+        if (*envHome) home = envHome;
+    }
+    std::wstring whome;
+    {
+        std::mbstate_t st{};
+        const char* src = home.c_str();
+        size_t n = std::mbsrtowcs(nullptr, &src, 0, &st);
+        if (n != (size_t)-1) {
+            whome.resize(n);
+            src = home.c_str();
+            std::mbsrtowcs(&whome[0], &src, n, &st);
+        }
+    }
+    Py_SetPythonHome(whome.c_str());
 #endif
 }
 
